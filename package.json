{
  "name": "imgconvert-cli",
  "version": "3.0.0",
  "description": "A CLI tool for compressing and converting images",
  "main": "src/index.js",
  "bin": {
    "imgconvert": "index.js"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "test": "node test/run.cjs",
    "test:general": "node test/run.cjs test/general.test.js",
    "test:brand": "node test/run.cjs test/brand.test.js",
    "test:alloy": "node test/run.cjs test/alloy.test.js",
    "test:config": "node test/run.cjs test/config.test.js",
    "test:help": "node test/run.cjs test/help.test.js",
    "test:verbose": "VERBOSE_TESTS=true node test/run.cjs",
    "test:watch": "node test/run.cjs --watch",
    "test:debug": "VERBOSE_TESTS=true node --inspect-brk test/run.cjs",
    "test:unit": "npm test",
    "test:integration": "npm test",
    "test:all": "npm test",
    "clean": "node -e \"console.log('Tests clean their exclusive temporary directories automatically.')\"",
    "clean-all": "npm run clean",
    "clean-force": "npm run clean && rm -rf node_modules/.cache/",
    "test:clean": "npm run clean && npm test",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "keywords": [
    "cli",
    "image",
    "compression",
    "convert",
    "webp",
    "avif",
    "sharp",
    "titanium",
    "alloy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "fast-xml-parser": "^5.12.0",
    "sharp": "^0.35.5",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macCesar/imgconvert-cli.git"
  },
  "bugs": {
    "url": "https://github.com/macCesar/imgconvert-cli/issues"
  },
  "homepage": "https://github.com/macCesar/imgconvert-cli#readme",
  "files": [
    "index.js",
    "src/**/*",
    "README.md",
    "CUSTOM_PRESETS.md",
    "CHANGELOG.md",
    "test/README.md",
    "images/README.md",
    "LICENSE"
  ],
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}

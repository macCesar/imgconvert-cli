{
  "name": "imgconvert-cli",
  "version": "1.4.0",
  "description": "A CLI tool for compressing and converting images",
  "main": "index.js",
  "bin": {
    "imgconvert": "./index.js"
  },
  "scripts": {
    "test": "mocha test/simple.test.js --timeout 300000",
    "test:verbose": "VERBOSE_TESTS=true mocha test/simple.test.js --timeout 300000 --reporter spec",
    "test:watch": "mocha test/simple.test.js --timeout 300000 --watch",
    "test:debug": "VERBOSE_TESTS=true mocha test/simple.test.js --timeout 300000 --reporter spec --inspect-brk",
    "clean-all": "rm -rf test/temp-test app"
  },
  "keywords": [
    "cli",
    "image",
    "compression",
    "convert",
    "webp",
    "avif",
    "sharp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "minimist": "^1.2.8",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "mocha": "^11.4.0"
  }
}
